# Local build products and reproducibility evidence. Keep immutable hashes in reports.
/artifacts/
/.install_logs/
/estimation.csv

# Runtime and SDK logs.
*.log

# Generated model/data payloads.
*.har
*.hef
*.onnx
*.pth
*.pt
*.ckpt
*.hdf5
*.npy
*.npz
*.auto.alls

# Local-only agent/environment instructions.
/CLAUDE.md

# Python/editor generated files.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vscode/

# Editor and patch backups.
*.orig
*~

# --- TRT / Hailo pipeline deployment additions ---

# CMake / native build trees (out-of-tree builds are recommended; keep them out).
build/
build-*/
cmake-build-*/
CMakeCache.txt
CMakeFiles/

# C++ object / library / binary products.
*.o
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe

# TensorRT engines and timing caches: bound to the TensorRT version AND the GPU
# architecture they were built on. They must be rebuilt on the target box.
/receiver_trt/build/
*.engine
*.timing.cache

# The exported codec tables are a build artefact regenerated by
# cpp/tools/export_codec_tables.py from the student checkpoint.
cpp/codec_tables.bin

# Local delivery bundles produced for handoff.
/deliverbale/
/delivery/
/SHA256SUMS
